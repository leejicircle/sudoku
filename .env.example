# ──────────────────────────────────────────────
# Database — 로컬 개발 (기본값, 이걸 쓴다)
# ──────────────────────────────────────────────
# `docker compose up -d db`로 로컬 Postgres 17을 띄운 뒤 아래 값을 그대로 사용.
# 개발 중 `pnpm db:migrate`(prisma migrate dev)는 반드시 이 로컬 DB에만 실행한다 —
# migrate dev는 실행할 때마다 shadow DB를 같은 인스턴스에 만들었다 지우므로,
# 클라우드에 돌리면 Supabase Free tier의 디스크 I/O 버짓이 한 번에 크게 깎인다.
DATABASE_URL=postgresql://sudoku:sudoku@localhost:5432/sudoku
DIRECT_URL=postgresql://sudoku:sudoku@localhost:5432/sudoku

# ──────────────────────────────────────────────
# Database — Supabase 클라우드 (⚠️ 배포/프리뷰 전용)
# ──────────────────────────────────────────────
# ⚠️ 로컬 .env에 넣지 말 것. Vercel 환경변수에만 설정한다.
# ⚠️ 이 URL에는 `db:migrate` / `db:push` / `db:studio` / `vitest`를 실행하지 않는다.
#    스키마 반영이 필요하면 `pnpm db:deploy`(prisma migrate deploy)만 사용 —
#    shadow DB를 만들지 않아 IO 비용이 거의 없다.
#
# Supabase 대시보드 > Settings > Database > Connection string 에서
# Transaction / Session 탭의 URI를 각각 복사하여 붙여넣기
# [YOUR-PASSWORD] 부분만 DB 비밀번호로 교체 (괄호 포함 삭제)
# 비밀번호에 특수문자가 있으면 URL 인코딩 필요 (예: ! → %21)
#
# Transaction 탭 URI (port 6543) → DATABASE_URL (Prisma Client 런타임용)
# Session 탭 URI     (port 5432) → DIRECT_URL   (Prisma Migrate용)

# ──────────────────────────────────────────────
# Auth.js v5
# ──────────────────────────────────────────────
# `npx auth secret` 또는 `openssl rand -base64 33`으로 생성
AUTH_SECRET=
# Google Cloud Console > OAuth 2.0 Client에서 발급
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Naver Developers > 애플리케이션에서 발급
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
# 로컬: http://localhost:3000 / 프로덕션: 실제 도메인
NEXT_PUBLIC_APP_URL=
